/* =========================================================
   ANI - ADAPTIVE NARRATIVE INTELLIGENCE
   ========================================================= */

* {
    box-sizing: border-box;
}


body {

    margin: 0;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    background:
        linear-gradient(
            135deg,
            #09090f,
            #151524
        );

    color: white;

    min-height: 100vh;

}


.container {

    width: 90%;

    max-width: 1000px;

    margin: auto;

    padding:
        70px 0;

}


/* =========================================================
   HERO
   ========================================================= */

.hero {

    text-align: center;

    margin-bottom: 50px;

}


.eyebrow {

    font-size: 13px;

    letter-spacing: 3px;

    font-weight: bold;

    opacity: 0.7;

    margin-bottom: 20px;

}


.hero h1 {

    font-size:
        clamp(
            40px,
            7vw,
            72px
        );

    line-height: 1.05;

    margin: 0 auto 25px;

    max-width: 850px;

}


.intro {

    font-size: 18px;

    line-height: 1.7;

    opacity: 0.75;

    max-width: 700px;

    margin: auto;

}


/* =========================================================
   CARD
   ========================================================= */

.story-card {

    background:
        rgba(
            255,
            255,
            255,
            0.06
        );

    border:
        1px solid
        rgba(
            255,
            255,
            255,
            0.12
        );

    border-radius: 25px;

    padding: 40px;

    backdrop-filter:
        blur(20px);

    box-shadow:
        0 30px 80px
        rgba(
            0,
            0,
            0,
            0.3
        );

}


.story-card h2 {

    font-size: 32px;

    margin-top: 0;

}


.section-description {

    opacity: 0.65;

    margin-bottom: 30px;

}


/* =========================================================
   EMOTIONS
   ========================================================= */

.emotion-grid {

    display: grid;

    grid-template-columns:
        repeat(
            3,
            1fr
        );

    gap: 15px;

}


.emotion-btn {

    padding: 18px;

    border-radius: 15px;

    border:
        1px solid
        rgba(
            255,
            255,
            255,
            0.15
        );

    background:
        rgba(
            255,
            255,
            255,
            0.05
        );

    color: white;

    font-size: 16px;

    cursor: pointer;

    transition:
        0.25s ease;

}


.emotion-btn:hover {

    transform:
        translateY(-3px);

    background:
        rgba(
            255,
            255,
            255,
            0.12
        );

}


.emotion-btn.selected {

    background:
        rgba(
            255,
            255,
            255,
            0.18
        );

    border-color:
        rgba(
            255,
            255,
            255,
            0.5
        );

    transform:
        translateY(-3px);

}


/* =========================================================
   SELECTED EMOTION
   ========================================================= */

.selected-emotion {

    margin-top: 25px;

    margin-bottom: 20px;

    opacity: 0.7;

}


/* =========================================================
   BUTTONS
   ========================================================= */

.begin-btn {

    width: 100%;

    padding: 18px;

    border: none;

    border-radius: 15px;

    background:
        white;

    color:
        #111;

    font-size: 17px;

    font-weight: bold;

    cursor: pointer;

    transition:
        0.25s ease;

}


.begin-btn:hover:not(:disabled) {

    transform:
        translateY(-2px);

}


.begin-btn:disabled {

    opacity: 0.4;

    cursor:
        not-allowed;

}


/* =========================================================
   STORY
   ========================================================= */

.story-header {

    margin-bottom: 30px;

}


.story-content {

    font-size: 21px;

    line-height: 1.8;

    padding: 30px;

    border-radius: 18px;

    background:
        rgba(
            255,
            255,
            255,
            0.05
        );

    margin-bottom: 35px;

}


.choice-section h3 {

    margin-bottom: 20px;

}


.choices {

    display: grid;

    gap: 12px;

}


.choice-btn {

    padding: 17px;

    text-align: left;

    border-radius: 13px;

    border:
        1px solid
        rgba(
            255,
            255,
            255,
            0.15
        );

    background:
        rgba(
            255,
            255,
            255,
            0.05
        );

    color: white;

    font-size: 16px;

    cursor: pointer;

    transition:
        0.2s ease;

}


.choice-btn:hover {

    background:
        rgba(
            255,
            255,
            255,
            0.13
        );

    transform:
        translateX(5px);

}


/* =========================================================
   LOADING
   ========================================================= */

.loading {

    text-align: center;

    padding: 20px;

    opacity: 0.7;

}


/* =========================================================
   RESTART
   ========================================================= */

.restart-btn {

    margin-top: 30px;

    padding: 12px 20px;

    border-radius: 10px;

    border:
        1px solid
        rgba(
            255,
            255,
            255,
            0.2
        );

    background:
        transparent;

    color: white;

    cursor: pointer;

}


/* =========================================================
   UTILITIES
   ========================================================= */

.hidden {

    display: none;

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (
    max-width: 700px
) {

    .container {

        padding:
            40px 0;

    }


    .story-card {

        padding: 25px;

    }


    .emotion-grid {

        grid-template-columns:
            1fr;

    }


    .hero h1 {

        font-size: 40px;

    }


    .story-content {

        font-size: 18px;

    }

}

/* =========================================================
   NARRATIVE STATE DASHBOARD
   ========================================================= */

.state-dashboard {

    margin-top: 30px;

    padding: 25px;

    border-radius: 18px;

    background:
        rgba(
            255,
            255,
            255,
            0.04
        );

    border:
        1px solid
        rgba(
            255,
            255,
            255,
            0.10
        );

}


.state-header {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;

    margin-bottom: 25px;

}


.state-header h3 {

    margin: 5px 0 0;

}


#emotion-display {

    padding:
        8px 14px;

    border-radius: 20px;

    background:
        rgba(
            255,
            255,
            255,
            0.08
        );

    font-size: 13px;

}


.state-row {

    margin-bottom: 18px;

}


.state-label {

    display: flex;

    justify-content: space-between;

    margin-bottom: 7px;

    font-size: 14px;

}


.state-bar {

    width: 100%;

    height: 8px;

    background:
        rgba(
            255,
            255,
            255,
            0.08
        );

    border-radius: 20px;

    overflow: hidden;

}


.state-fill {

    height: 100%;

    width: 50%;

    border-radius: 20px;

    background: white;

    transition:
        width 0.5s ease;

}


.completion-message {

    margin-top: 25px;

    padding: 25px;

    border-radius: 16px;

    background:
        rgba(
            255,
            255,
            255,
            0.06
        );

}


.completion-message h3 {

    margin-top: 0;

}


@media (
    max-width: 600px
) {

    .state-header {

        align-items:
            flex-start;

        flex-direction:
            column;

    }

}